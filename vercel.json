{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "treetrimmersnc.online" }],
      "destination": "https://godhans.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.treetrimmersnc.online" }],
      "destination": "https://godhans.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "prompt-precise-react.vercel.app" }],
      "destination": "https://godhans.com/$1",
      "permanent": true
    },
    { "source": "/services/tree-removal", "destination": "/tree-removal-jacksonville-nc", "permanent": true },
    { "source": "/services/tree-trimming", "destination": "/tree-trimming-jacksonville-nc", "permanent": true },
    { "source": "/services/stump-grinding", "destination": "/stump-grinding-jacksonville-nc", "permanent": true },
    { "source": "/services/emergency-tree-service", "destination": "/emergency-tree-service-jacksonville-nc", "permanent": true },
    { "source": "/services/land-clearing", "destination": "/land-clearing-jacksonville-nc", "permanent": true },
    { "source": "/services/storm-cleanup", "destination": "/storm-cleanup-jacksonville-nc", "permanent": true },
    { "source": "/locations/jacksonville-nc", "destination": "/tree-service-jacksonville-nc", "permanent": true },
    { "source": "/locations/hubert-nc", "destination": "/tree-service-hubert-nc", "permanent": true },
    { "source": "/locations/richlands-nc", "destination": "/tree-service-richlands-nc", "permanent": true },
    { "source": "/locations/swansboro-nc", "destination": "/tree-service-swansboro-nc", "permanent": true },
    { "source": "/locations/sneads-ferry-nc", "destination": "/tree-service-sneads-ferry-nc", "permanent": true },
    { "source": "/locations/camp-lejeune-nc", "destination": "/tree-service-camp-lejeune-nc", "permanent": true },
    { "source": "/locations/maysville-nc", "destination": "/tree-service-jacksonville-nc", "permanent": true },
    { "source": "/locations/beulaville-nc", "destination": "/tree-service-jacksonville-nc", "permanent": true },
    { "source": "/locations/holly-ridge-nc", "destination": "/tree-service-jacksonville-nc", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

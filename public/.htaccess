# 301 Redirect old domain to new primary domain (preserves SEO authority)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?treetrimmersnc\.online$ [NC]
  RewriteRule ^(.*)$ https://godhans.com/$1 [R=301,L]

  # Force HTTPS + non-www canonical
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.godhans\.com$ [NC]
  RewriteRule ^(.*)$ https://godhans.com/$1 [R=301,L]
</IfModule>

# IONOS Cache Control Headers for Performance Optimization
<IfModule mod_headers.c>
  # Cache static assets for 1 year (immutable)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Cache CSS and JavaScript for 1 year
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Cache external scripts (chat widget) for shorter period
  <FilesMatch "~flock\.js$">
    Header set Cache-Control "public, max-age=1500"
  </FilesMatch>
  
  # Cache HTML for 1 hour
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
